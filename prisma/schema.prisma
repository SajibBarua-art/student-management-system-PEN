// This is your Prisma schema file for the Student Management System - Registry Module
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnrolmentStatus {
  ENROLLED
  DEFERRED
  WITHDRAWN
  COMPLETED
}

enum GradeClassification {
  DISTINCTION
  MERIT
  PASS
  FAIL
}

enum ECStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ECReason {
  MEDICAL
  BEREAVEMENT
  ACUTE_PERSONAL
  TECHNICAL_FAILURE
}

model Programme {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  department    String
  standardFee   Float
  durationYears Int          @default(3)
  description   String?
  students      Student[]
  assessments   Assessment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Student {
  id           String          @id @default(cuid())
  studentId    String          @unique // e.g., SMS-2025-0001
  fullName     String
  email        String          @unique
  dateOfBirth  DateTime
  academicYear String // e.g., 2024/2025
  status       EnrolmentStatus @default(ENROLLED)
  programmeId  String
  programme    Programme       @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  fees         StudentFee[]
  payments     Payment[]
  submissions  Submission[]
  grades       Grade[]
  extenuatingCircumstances ExtenuatingCircumstance[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([academicYear])
  @@index([programmeId])
}

enum FeeType {
  TUITION
  INSTALMENT_TRANCHE
  SCHOLARSHIP_WAIVER
  HARDSHIP_BURSARY
  ADMINISTRATIVE
}

model StudentFee {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount       Float
  description  String
  feeType      FeeType  @default(TUITION)
  dueDate      DateTime
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studentId])
  @@index([feeType])
}

model Payment {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount          Float
  paymentDate     DateTime @default(now())
  referenceNumber String   @unique // e.g., TXN-2025-0001
  paymentMethod   String   @default("Bank Transfer")
  notes           String?
  createdAt       DateTime @default(now())

  @@index([studentId])
  @@index([paymentDate])
}

model Assessment {
  id           String       @id @default(cuid())
  title        String
  moduleCode   String
  moduleName   String
  programmeId  String?
  programme    Programme?   @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  description  String?
  deadline     DateTime
  totalMarks   Int          @default(100)
  credits      Int          @default(15) // Modular credit weighting (e.g., 15 or 30 CATS/ECTS credits)
  academicYear String
  submissions  Submission[]
  grades       Grade[]
  extenuatingCircumstances ExtenuatingCircumstance[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([moduleCode])
  @@index([academicYear])
}

model Submission {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  submittedAt  DateTime   @default(now())
  isLate       Boolean    @default(false)
  version      Int        @default(1)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([studentId, assessmentId])
  @@index([assessmentId])
  @@index([studentId])
}

model Grade {
  id             String              @id @default(cuid())
  assessmentId   String
  assessment     Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  numericGrade   Float
  classification GradeClassification
  feedback       String?
  isPublished    Boolean             @default(false)
  publishedAt    DateTime?
  gradedAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([studentId, assessmentId])
  @@index([assessmentId])
  @@index([studentId])
  @@index([isPublished])
}

model ExtenuatingCircumstance {
  id                     String     @id @default(cuid())
  studentId              String
  student                Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId           String
  assessment             Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  reason                 ECReason   @default(MEDICAL)
  explanation            String
  requestedExtensionDays Int        @default(7)
  status                 ECStatus   @default(PENDING)
  staffNotes             String?
  reviewedBy             String?
  reviewedAt             DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@unique([studentId, assessmentId])
  @@index([studentId])
  @@index([assessmentId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // e.g. GRADE_MODIFIED, MARKSHEET_PUBLISHED, STATUS_OVERRIDDEN
  actor      String   @default("Academic Registry")
  role       String   @default("REGISTRY_OFFICER")
  entityType String   // e.g. GRADE, ASSESSMENT, STUDENT, FEE, EXTENUATING_CIRCUMSTANCE
  entityId   String?
  details    String
  ipAddress  String?  @default("127.0.0.1 (Internal Registry)")
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

